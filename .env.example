# 数据库
DATABASE_URL=sqlite:///./data/rag_kb.db

# JWT 密钥（请修改为随机字符串）
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Qdrant 向量数据库
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_knowledge_base
QDRANT_IN_MEMORY=true  # Windows 本地部署时设为 true，不依赖 Docker

# Embedding 配置
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=384

# LLM 默认配置（可在管理后台覆盖）
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-chat
DEFAULT_API_BASE=https://api.deepseek.com

# 文件存储
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# 企业设置
MAX_USERS_PER_ENTERPRISE=100
